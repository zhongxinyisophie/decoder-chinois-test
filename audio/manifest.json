    "sourceStart": 31.98,
    "sourceEnd": 33.443,
    "sha256": "4be7f127b6e4404940306de7de92cea702dff5b55be65a597ec03a53a03511a8"
  },
  {
    "lesson": 1,
    "text": "我七点左右起床。",
    "file": "audio/lesson-01/09.m4a",
    "sourceStart": 37.15,
    "sourceEnd": 40.492,
    "sha256": "660798222c1444966b1008d200ede03e418372c0a002d50fd212a2fe7c657df4"
  },
  {
    "lesson": 1,
    "text": "我八点半上班。",
    "file": "audio/lesson-01/10.m4a",
    "sourceStart": 44.02,
    "sourceEnd": 46.95,
    "sha256": "dbb54b49afef46abc4cf09e7be3d8a27eeb3d2ea5326de8a1a8eef16caffb0c2"
  },
  {
    "lesson": 1,
    "text": "我下午六点下班。",
    "file": "audio/lesson-01/11.m4a",
    "sourceStart": 49.78,
    "sourceEnd": 53.284,
    "sha256": "29c314e7cd2d50afdc860701c44f1d0d947047780de2c08f7eff147ccfadd3c5"
  },
  {
    "lesson": 1,
    "text": "下班以后，我回家。",
    "file": "audio/lesson-01/12.m4a",
    "sourceStart": 56.04,
    "sourceEnd": 59.729,
    "sha256": "9ee8fbf6c5b8e941b1126be6f4e8a9284465eedd711ee219dbd86b9518c6b445"
  },
  {
    "lesson": 1,
    "text": "回家以后，我做饭。",
    "file": "audio/lesson-01/13.m4a",
    "sourceStart": 62.98,
    "sourceEnd": 66.88,
    "sha256": "ccd06de4fe7347acefce2ccf8e0ff129da9b64bf819fe65ed0c793737ab1ef41"
  },
  {
    "lesson": 1,
    "text": "我先做饭，再看书。",
    "file": "audio/lesson-01/14.m4a",
    "sourceStart": 69.48,
    "sourceEnd": 74.057,
    "sha256": "b500c8093b846516cd106e6792a52bbdd49b7bfaee9c39a20d4c3012b385cb11"
  },
  {
    "lesson": 1,
    "text": "我一般十一点左右睡觉。",
    "file": "audio/lesson-01/15.m4a",
    "sourceStart": 76.8,
    "sourceEnd": 80.723,
    "sha256": "37f93d51bb0097515640252d8fd5f2fb738841a495cf9986b1c75b486cae168d"
  },
  {
    "lesson": 2,
