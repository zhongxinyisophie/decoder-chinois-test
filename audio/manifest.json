    "file": "audio/lesson-02/03.m4a",
    "sourceStart": 6.28,
    "sourceEnd": 8.556,
    "sha256": "a8e3e67243ca7738ab519264e2cf642e04972b1cb1633615d33081e5a8a450a6"
  },
  {
    "lesson": 2,
    "text": "运动",
    "file": "audio/lesson-02/04.m4a",
    "sourceStart": 9.9,
    "sourceEnd": 11.31,
    "sha256": "fd01d8646443700789b4601096ab89a85dcf0a699fc8f9fc05d5721a356a20e1"
  },
  {
    "lesson": 2,
    "text": "公园",
    "file": "audio/lesson-02/05.m4a",
    "sourceStart": 12.52,
    "sourceEnd": 14.153,
    "sha256": "9a6a8ad8ae5dbbe6b58d8adf621373b9f96a69fbd97a0cae068141568f83b593"
  },
  {
    "lesson": 2,
    "text": "电影",
    "file": "audio/lesson-02/06.m4a",
    "sourceStart": 15.8,
    "sourceEnd": 17.253,
    "sha256": "0f43b92e5c27a5f46a62ebc3a912f5f0bb48cdef694b454db005cf2668fb898f"
  },
  {
    "lesson": 2,
    "text": "喜欢",
    "file": "audio/lesson-02/07.m4a",
    "sourceStart": 18.705,
    "sourceEnd": 20.022,
    "sha256": "52982c5f4d96442a9f71114bd1a8603fef530595a24a7182436e757fd0b8f278"
  },
  {
    "lesson": 2,
    "text": "一起",
    "file": "audio/lesson-02/08.m4a",
    "sourceStart": 21.5,
    "sourceEnd": 23.02,
    "sha256": "d5d00dee4a0a9bf3d3d19a6946a39ee8bd7f954ec5835b10248f3bb0e49dfd2c"
  },
  {
    "lesson": 2,
    "text": "我周末一般休息。",
    "file": "audio/lesson-02/09.m4a",
    "sourceStart": 24.97,
    "sourceEnd": 28.39,
    "sha256": "a9d2c5697379ff91201298fb18394285de8af14c4d67721654778eb53dce283d"
  },
  {
    "lesson": 2,
    "text": "我喜欢看电影。",
    "file": "audio/lesson-02/10.m4a",
    "sourceStart": 29.94,
    "sourceEnd": 32.995,
    "sha256": "fd52b0a91109f9061f7cec9b246bbf43edbce1d0c62e9674882be1dd2a1edba5"
  },
  {
    "lesson": 2,
    "text": "我不太喜欢运动。",
    "file": "audio/lesson-02/11.m4a",
    "sourceStart": 34.71,
    "sourceEnd": 37.525,
    "sha256": "fa200f804dc363580e0318f901975b3c7d168747f1a3dcb14844e6574dd1c2a1"
  },
  {
    "lesson": 2,
    "text": "我周末跟朋友一起喝咖啡。",
    "file": "audio/lesson-02/12.m4a",
    "sourceStart": 39.62,
    "sourceEnd": 44.166,
    "sha256": "556b80ec944243a8e8ba0ed573f6f632b56b19b5b12f47c1e2c63e74bb697aa5"
  },
  {
    "lesson": 2,
    "text": "这个星期天一起去公园吧。",
    "file": "audio/lesson-02/13.m4a",
    "sourceStart": 45.26,
    "sourceEnd": 49.94,
    "sha256": "3579311480716f3aab758b95add160bbcb7834acb3597820c02ee50f712dc310"
  },
  {
    "lesson": 2,
    "text": "周末我一般九点左右起床。",
    "file": "audio/lesson-02/14.m4a",
    "sourceStart": 51.86,
    "sourceEnd": 56.494,
    "sha256": "025fd98f98fdcf18d47e603d4552cbc0f4a65c84c8147b7a6e32ef12c215b644"
  },
  {
    "lesson": 2,
    "text": "周末我先运动，再跟朋友一起喝咖啡。",
    "file": "audio/lesson-02/15.m4a",
    "sourceStart": 58.4,
    "sourceEnd": 64.935,
    "sha256": "37735464148bef359ff8ee1053b77d2ebb4705c2d970da548b4c89f5fc3cd3b8"
  },
  {
