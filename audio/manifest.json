    "lesson": 3,
    "text": "清淡",
    "file": "audio/lesson-03/06.m4a",
    "sourceStart": 19.364,
    "sourceEnd": 20.62,
    "sha256": "13e5192662de8ccf798044744ae12a4ab096e8aa3b4171b00fbc07250ae5a0e3"
  },
  {
    "lesson": 3,
    "text": "一份",
    "file": "audio/lesson-03/07.m4a",
    "sourceStart": 22.55,
    "sourceEnd": 23.753,
    "sha256": "1670f4d142a9430fe266a625d01b249facb7e4b2d382a54bfb1d9c884532896e"
  },
  {
    "lesson": 3,
    "text": "一碗",
    "file": "audio/lesson-03/08.m4a",
    "sourceStart": 25.8,
    "sourceEnd": 27.111,
    "sha256": "aca93ecf64fc99f0c54beea03d6c700fbbcaee1d3f6e230812d149a30af011cf"
  },
  {
    "lesson": 3,
    "text": "够",
    "file": "audio/lesson-03/09.m4a",
    "sourceStart": 28.84,
    "sourceEnd": 29.85,
    "sha256": "4207ac24f0274b27ad81a75e19c92ded291a41c3dff6cbe435168013608e589b"
  },
  {
    "lesson": 3,
    "text": "打包",
    "file": "audio/lesson-03/10.m4a",
    "sourceStart": 31.71,
    "sourceEnd": 33.092,
    "sha256": "0a4799fa7ed012b7c9b141dd85bb801b41163b07107e4c6499cb23aba9ab734a"
  },
  {
    "lesson": 3,
    "text": "买单",
    "file": "audio/lesson-03/11.m4a",
    "sourceStart": 34.85,
    "sourceEnd": 36.195,
    "sha256": "8869127b6cf35554c6c709cfed75a8213824608a28a3ef83e96670562757d73d"
  },
  {
    "lesson": 3,
    "text": "有什么推荐的吗？",
    "file": "audio/lesson-03/12.m4a",
    "sourceStart": 39.63,
    "sourceEnd": 41.97,
    "sha256": "4725fc535b5094162d90e7cc5e435bdd36a9ef7f53ac3eca10f70057a16704c7"
  },
  {
    "lesson": 3,
    "text": "你们有什么招牌菜？",
    "file": "audio/lesson-03/13.m4a",
    "sourceStart": 44.22,
    "sourceEnd": 47.209,
    "sha256": "645146680e786af9ab5479a80a762a048ac18f564a4400cbfeac0fde80ec01c1"
  },
  {
    "lesson": 3,
    "text": "这个里面有什么？",
    "file": "audio/lesson-03/14.m4a",
    "sourceStart": 49.6,
    "sourceEnd": 52.348,
    "sha256": "4d702ba224ea78c00923ff2ab61eb0f26d196bc5f53d294fb6d1d4e4563e368f"
  },
  {
    "lesson": 3,
    "text": "这个是用什么做的？",
    "file": "audio/lesson-03/15.m4a",
    "sourceStart": 54.91,
    "sourceEnd": 57.761,
    "sha256": "758751bfc35583856f195e86b7f96487666f50c4820b4be611bbaf1cd004648b"
  },
  {
    "lesson": 3,
    "text": "我不太能吃辣。",
    "file": "audio/lesson-03/16.m4a",
    "sourceStart": 59.61,
    "sourceEnd": 62.67,
    "sha256": "be7b6225a913256d9a43eae94d140784e98e75e811289439b519e0cfab0d7bfc"
  },
  {
    "lesson": 3,
    "text": "微辣就可以。",
    "file": "audio/lesson-03/17.m4a",
    "sourceStart": 64.8,
    "sourceEnd": 67.511,
    "sha256": "0e1d3be9ef21e9a3c8351e48aa2f8524af96e95373d38dd25de61b76bebe9808"
  },
  {
    "lesson": 3,
    "text": "清淡一点。",
    "file": "audio/lesson-03/18.m4a",
    "sourceStart": 70.26,
    "sourceEnd": 71.89,
    "sha256": "bfdbefe4719e9c7d9a5f25770be3b98fb5a16a3cb560806015c8694aefa3c4e8"
  },
  {
    "lesson": 3,
    "text": "不要香菜。",
    "file": "audio/lesson-03/19.m4a",
    "sourceStart": 74.08,
    "sourceEnd": 75.795,
    "sha256": "2e85c8488a90f6445faf4765e285142c6229f28470f43929e0299dab35a4d1e4"
  },
  {
    "lesson": 3,
    "text": "这个来一份。",
    "file": "audio/lesson-03/20.m4a",
    "sourceStart": 78.76,
    "sourceEnd": 80.706,
    "sha256": "f9c1b1f8ff2960e04c70d99390a5ca419d5c11fe8bb9cca9f1c113e7b7da3fcb"
  },
  {
    "lesson": 3,
    "text": "这个够几个人吃？",
    "file": "audio/lesson-03/21.m4a",
    "sourceStart": 83.62,
    "sourceEnd": 86.385,
    "sha256": "0fac6d199f59c4dad7fef7db16450f89a09adb7123557957ae64503d1a9955f6"
  },
  {
    "lesson": 3,
    "text": "先这些，谢谢。",
    "file": "audio/lesson-03/22.m4a",
    "sourceStart": 88.82,
    "sourceEnd": 90.835,
    "sha256": "822418bb3c9b29f871427d619d62c07b34d5dfdb26e5af2ec0863d8d64a55c0f"
  },
  {
    "lesson": 3,
    "text": "最后还有一点菜没吃完，所以我们就打包带回家了。",
    "file": "audio/lesson-03/23.m4a",
    "sourceStart": 94.521,
    "sourceEnd": 102.83,
    "sha256": "32fa4c22b76891f846c5cfd764665f89cd7ad06bb110d3e4b4726161b8fd50e1"
  },
  {
    "lesson": 3,
    "text": "我朋友很能吃辣，但是我不太能吃辣。",
    "file": "audio/lesson-03/24.m4a",
    "sourceStart": 105.01,
    "sourceEnd": 110.95,
    "sha256": "326c6f7782967950f76d707ef9edf833ab663e24dfc2d74ac8b1840fee7fe184"
  },
  {
    "lesson": 4,
    "text": "衣服",
    "file": "audio/lesson-04/01.m4a",
    "sourceStart": 1.06,
    "sourceEnd": 2.523,
    "sha256": "92d73955013632fd9d09c58b03cb282c5911d445a97a5bedc37b2d639329d86b"
  },
  {
