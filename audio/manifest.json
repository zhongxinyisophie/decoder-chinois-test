    "sha256": "e8e9321f49d93effd21f459c973a088933b7e0755c9a9384abdc070198ea55af"
  },
  {
    "lesson": 4,
    "text": "我要这个",
    "file": "audio/lesson-04/14.m4a",
    "sourceStart": 42.78,
    "sourceEnd": 44.294,
    "sha256": "568cd33a8eb86c2f1eac4702d9b5ef2aa61cabd68fa4e103615effddafd38636"
  },
  {
    "lesson": 4,
    "text": "这个多少钱？",
    "file": "audio/lesson-04/15.m4a",
    "sourceStart": 46.38,
    "sourceEnd": 49.727,
    "sha256": "a8d8c425f473794602cb250900e317e1bec8494e7315f523b016e9f77acac2f6"
  },
  {
    "lesson": 4,
    "text": "这个可以试一下吗？",
    "file": "audio/lesson-04/16.m4a",
    "sourceStart": 52.12,
    "sourceEnd": 55.575,
    "sha256": "e922fc4cd78cbe208bc97871386e7b2ac52b194b50705546309dcf991c32c4b1"
  },
  {
    "lesson": 4,
    "text": "你穿多大？",
    "file": "audio/lesson-04/17.m4a",
    "sourceStart": 57.98,
    "sourceEnd": 59.62,
    "sha256": "ab81d4e725c1582b16af62575c19f7cb07ca28d381460a1dca6d3be63a13d273"
  },
  {
    "lesson": 4,
    "text": "我穿中码。",
    "file": "audio/lesson-04/18.m4a",
    "sourceStart": 61.97,
    "sourceEnd": 63.77,
    "sha256": "daaa8b0ac9e361d41d0e5b9f5fe7cd84f8ff0b9afc305dfff3c19d465b968273"
  },
  {
    "lesson": 4,
    "text": "这个有点小。",
    "file": "audio/lesson-04/19.m4a",
    "sourceStart": 65.91,
    "sourceEnd": 68.15,
    "sha256": "3087129b77510a06f40d5c1d9a419cc7966e8081b8bffa501abb3e34594883ab"
  },
  {
    "lesson": 4,
    "text": "有大一点的吗？",
    "file": "audio/lesson-04/20.m4a",
    "sourceStart": 70.2,
    "sourceEnd": 72.0,
    "sha256": "fb182625dc4380f7ae0b245a29a918ac61e245e3879c4179c46e9c87a65d3c35"
  },
  {
    "lesson": 4,
    "text": "这个很合适。",
    "file": "audio/lesson-04/21.m4a",
    "sourceStart": 74.39,
    "sourceEnd": 76.63,
    "sha256": "0d98ddf9fa0c1177e42a391ecaef1f5bf1c2feeb1c430fb57c8fb664c18f2192"
  },
  {
    "lesson": 4,
    "text": "有别的颜色吗？",
    "file": "audio/lesson-04/22.m4a",
    "sourceStart": 78.96,
    "sourceEnd": 80.906,
    "sha256": "f017d5f7663f2d30a547ad65e8d1c34d4a7961d765562f872606be4372c62df9"
  },
  {
    "lesson": 4,
    "text": "黑色的有吗？",
    "file": "audio/lesson-04/23.m4a",
    "sourceStart": 83.24,
    "sourceEnd": 84.84,
    "sha256": "e13abafd9a8270dbe54ca664856e17fe46eddeb96f1cf733a14abb9af27c44b1"
  },
  {
    "lesson": 4,
    "text": "有折扣吗？",
    "file": "audio/lesson-04/24.m4a",
    "sourceStart": 87.8,
    "sourceEnd": 89.356,
    "sha256": "292ac7098594bd4f17d604a8b9abcefd16f9e2507769fb0095ab8d29547cf6c6"
  },
  {
    "lesson": 4,
    "text": "好，我要这个。",
    "file": "audio/lesson-04/25.m4a",
    "sourceStart": 91.8,
    "sourceEnd": 93.967,
    "sha256": "f5eb5b4990de9641293493d99f7c9b6bcec2e6f4e9984ee859df55aeba6648a9"
  },
  {
    "lesson": 4,
    "text": "我平时穿中码，但是这件中码有点小，所以我试了大码。",
    "file": "audio/lesson-04/26.m4a",
    "sourceStart": 96.93,
    "sourceEnd": 107.89,
    "sha256": "c32e0fef85a9eeec637a3c82002d6e1a38643463de1ce1fa38d463eba895ebd5"
  }
]
